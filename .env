# Kafka / Redpanda Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_CLICKSTREAM=user-clicks

# Database (PostgreSQL with pgvector) Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lakehouse_db
DB_USER=lakehouse_user
DB_PASSWORD=lakehouse_password
DATABASE_URL=postgresql://lakehouse_user:lakehouse_password@localhost:5432/lakehouse_db

# Google Gemini API Key (Enter your key here, or leave empty to use Mock LLM mode)
GEMINI_API_KEY=

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=llama3:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Lakehouse Data Paths
LAKEHOUSE_PATH=c:/Users/omerc/OneDrive/Masaüstü/deneme/data/lakehouse
